# Application Settings
PROJECT_NAME="Smart Peel AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Security & Authentication
# Generate a secure random key for production using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="smart-peel-ai-dev-secret-key-change-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Local development SQLite; PostgreSQL for production: postgresql://user:password@localhost/smartpeel
DATABASE_URL="sqlite:///./smart_peel_ai.db"

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS="http://localhost,http://localhost:3000,http://localhost:8000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8000"

# Storage & AI Models
UPLOAD_DIR="./uploads"
MODEL_PATH="../ai/models/smart_peel_mobilenetv3.keras"
CONFIDENCE_THRESHOLD=0.65
